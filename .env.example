# Plantilla de variables de entorno. Copiar a `.env` (no versionado) y cambiar
# TODOS los valores. Los de este archivo son ficticios y no deben usarse jamas
# fuera de un equipo de desarrollo local.

# --- PostgreSQL ---------------------------------------------------------
# Superusuario del cluster (solo administracion local / scripts de init).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiame-superuser-ficticio
# Nombre de la base de datos.
POS_DB_NAME=pos
# Puerto publicado en 127.0.0.1.
POS_POSTGRES_PORT=5432

# --- Usuarios de aplicacion --------------------------------------------
# Runtime: pos_app (login, no superusuario, sin CREATE; solo DML).
POS_DB_USER=pos_app
POS_DB_PASSWORD=cambiame-app-ficticio
# Migraciones: pos_owner (dueno del esquema; lo usa Flyway).
POS_FLYWAY_USER=pos_owner
POS_FLYWAY_PASSWORD=cambiame-owner-ficticio

# URL JDBC para ejecutar la api FUERA de Docker (en Docker la fija compose).
# Mantenerla alineada con POS_POSTGRES_PORT y POS_DB_NAME (puerto y base de arriba).
POS_DB_URL=jdbc:postgresql://localhost:5432/pos

# --- Seguridad ----------------------------------------------------------
# Secreto de firma de JWT. Generar uno propio, p. ej.: openssl rand -base64 48
POS_JWT_SECRET=cambiame-jwt-ficticio-de-al-menos-32-caracteres
# Hash BCrypt (costo 12) de la clave del administrador inicial. OBLIGATORIO
# para el servicio `api` de Docker (perfiles demo/prod). El valor de abajo es un
# marcador INVALIDO (solo permite que compose valide): reemplazarlo por un hash real,
# y escribirlo ENTRE COMILLAS SIMPLES para que Compose no interpole los `$`, p. ej.:
#   POS_ADMIN_PASSWORD_HASH='$2a$12$...'
POS_ADMIN_PASSWORD_HASH='cambiame-generar-hash-bcrypt-costo-12'

# --- Spring -------------------------------------------------------------
# Perfil al correr la api FUERA de Docker (dev | demo | test | prod).
SPRING_PROFILES_ACTIVE=dev
# Perfil de la api DENTRO de Docker (no hereda SPRING_PROFILES_ACTIVE): prod | demo.
POS_API_PROFILE=prod

# --- Mailpit y web (puertos en 127.0.0.1) --------------------------------
POS_MAILPIT_SMTP_PORT=1025
POS_MAILPIT_UI_PORT=8025
POS_WEB_PORT=8080

# --- Opcionales de la api (descomentar solo si hace falta) ----------------
# URL JDBC de Flyway si difiere de POS_DB_URL (p. ej. conexion directa sin pooler).
# POS_FLYWAY_URL=jdbc:postgresql://localhost:5432/pos
# Directorio de archivos (en Docker compose lo fija a /data/files).
# POS_FILES_ROOT=./data/files
# Origenes CORS permitidos, separados por coma. Vacio = mismo origen (via nginx).
# POS_CORS_ALLOWED_ORIGINS=http://localhost:4200
# SMTP (por defecto localhost:1025 = Mailpit; en Docker host=mailpit, port=1025).
# POS_MAIL_HOST=localhost
# POS_MAIL_PORT=1025
# POS_MAIL_USER=
# POS_MAIL_PASSWORD=
# POS_MAIL_AUTH=false
# POS_MAIL_STARTTLS=false
# POS_MAIL_FROM=no-reply@minimarket.local
# Tamano maximo del pool de conexiones (por defecto 10).
# POS_DB_POOL_SIZE=10
# Puerto HTTP de la api (por defecto 8080). Si se cambia, ajustar nginx (docker/nginx).
# POS_SERVER_PORT=8080
